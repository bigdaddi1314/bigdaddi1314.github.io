<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Maison 704 | Charlotte Sculpted Accessories &amp; Custom Purse Boutique</title>

  <!-- Google Fonts: Cormorant Garamond (Editorial Fashion Display) + Plus Jakarta Sans (Clean Boutique UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            pearl: '#FFFBF8',
            blush: '#FBE8EE',
            champagne: '#C6986C',
            roseBerry: '#C23B6B',
            roseDeep: '#A32B56',
            espresso: '#24191D',
            mauve: '#6E5A62',
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
          },
        },
      },
    };
  </script>

  <!-- Three.js r128 + OrbitControls + STLExporter (Reliable CDN setup for Web & Antigravity porting) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/exporters/STLExporter.js"></script>

  <style>
    /* =========================================================================
       DESIGN TOKENS (Structured cleanly for effortless Antigravity app porting)
       ========================================================================= */
    :root {
      --bg-pearl-glass: rgba(255, 251, 248, 0.86);
      --bg-pearl-strong: rgba(255, 251, 248, 0.94);
      --bg-blush-soft: #FBE8EE;
      --border-champagne: rgba(198, 152, 108, 0.38);
      --border-champagne-strong: rgba(198, 152, 108, 0.62);
      --accent-rose: #C23B6B;
      --accent-rose-hover: #A62D58;
      --accent-gold: #C6986C;
      --ink-espresso: #24191D;
      --ink-mauve: #6E5A62;
      --radius-card: 1.75rem;
      --radius-pill: 9999px;
      --shadow-boutique: 0 20px 50px rgba(48, 22, 34, 0.14), 0 4px 16px rgba(198, 152, 108, 0.12);
      --shadow-soft: 0 12px 32px rgba(48, 22, 34, 0.09);
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      color: var(--ink-espresso);
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background-color: #2c1b29;
      overflow-x: hidden;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* Extra bottom spacing on mobile for native-feeling bottom app navigation bar */
    @media (max-width: 767px) {
      body {
        padding-bottom: 76px;
      }
    }

    /* =========================================================================
       PHOTOREALISTIC MOVING CHARLOTTE SKYLINE BACKDROP
       ========================================================================= */
    #skyline-stage {
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
      background: linear-gradient(160deg, #4b2a46 0%, #8e4765 48%, #d78a76 100%);
    }

    #skyline-photo-wrap {
      position: absolute;
      inset: -8%;
      width: 116%;
      height: 116%;
      will-change: transform;
      transform-origin: center center;
    }

    #skyline-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 42%;
      filter: saturate(1.16) brightness(1.06) contrast(1.03);
      transition: filter 0.6s ease;
    }

    /* Vibrant Boutique Color Wash Layers */
    #skyline-wash {
      position: absolute;
      inset: 0;
      transition: background 0.7s ease, opacity 0.7s ease;
    }

    /* Golden Blush (Default): Warm Rose Sunset, Peach Gold & Luminous Plum */
    .wash-golden-blush {
      background:
        radial-gradient(circle at 18% 15%, rgba(255, 206, 173, 0.48) 0%, transparent 52%),
        radial-gradient(circle at 82% 24%, rgba(242, 128, 166, 0.42) 0%, transparent 55%),
        linear-gradient(180deg, rgba(114, 48, 86, 0.46) 0%, rgba(214, 114, 134, 0.34) 48%, rgba(247, 198, 168, 0.42) 100%);
      mix-blend-mode: screen;
      opacity: 0.78;
    }

    /* Vibrant Twilight: Rich Sunset Plum, Roseberry & Warm Amber Skyline Glow */
    .wash-vibrant-twilight {
      background:
        radial-gradient(circle at 22% 20%, rgba(194, 59, 107, 0.42) 0%, transparent 55%),
        radial-gradient(circle at 78% 75%, rgba(244, 162, 118, 0.38) 0%, transparent 55%),
        linear-gradient(180deg, rgba(58, 25, 62, 0.44) 0%, rgba(145, 52, 95, 0.32) 55%, rgba(224, 138, 122, 0.34) 100%);
      mix-blend-mode: normal;
      opacity: 0.85;
    }

    /* Clear Skyline: Crisp Photorealistic View with Gentle Champagne Veil */
    .wash-clear-skyline {
      background:
        linear-gradient(180deg, rgba(42, 24, 38, 0.22) 0%, rgba(198, 152, 108, 0.14) 55%, rgba(255, 244, 238, 0.24) 100%);
      mix-blend-mode: normal;
      opacity: 0.7;
    }

    /* Soft atmospheric vignette so foreground pearl cards always read crisply */
    #skyline-veil {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(255, 245, 248, 0.12) 0%, rgba(255, 240, 245, 0.06) 45%, rgba(36, 25, 29, 0.24) 100%);
    }

    #bokeh-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    /* =========================================================================
       FROSTED PEARL & CHAMPAGNE BOUTIQUE SURFACES
       ========================================================================= */
    .pearl-card {
      background: var(--bg-pearl-glass);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-champagne);
      box-shadow: var(--shadow-boutique);
    }

    .pearl-card-strong {
      background: var(--bg-pearl-strong);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--border-champagne-strong);
      box-shadow: var(--shadow-boutique);
    }

    .editorial-frame {
      background: linear-gradient(145deg, #FFF7F9 0%, #FBE8EE 52%, #F6E4D4 100%);
    }

    /* Custom Boutique Range Slider */
    input[type="range"].boutique-range {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 6px;
      border-radius: 999px;
      background: linear-gradient(90deg, #F3D1DD, #E2B996);
      outline: none;
      cursor: pointer;
    }
    input[type="range"].boutique-range::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #C23B6B;
      border: 3px solid #FFFBF8;
      box-shadow: 0 3px 10px rgba(194, 59, 107, 0.35);
      transition: transform 0.15s ease;
    }
    input[type="range"].boutique-range::-webkit-slider-thumb:hover {
      transform: scale(1.12);
    }

    /* 3D Canvas Container Touch Handling */
    .three-mount canvas {
      display: block;
      width: 100% !important;
      height: 100% !important;
      touch-action: none;
      cursor: grab;
    }
    .three-mount canvas:active {
      cursor: grabbing;
    }

    /* Soft Scrollbar */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #FAF0F3; }
    ::-webkit-scrollbar-thumb { background: #D7B294; border-radius: 999px; }
    ::-webkit-scrollbar-thumb:hover { background: #C23B6B; }
  </style>
</head>
<body class="selection:bg-blush selection:text-roseBerry">

  <!-- ==================== FIXED PHOTOREALISTIC CHARLOTTE SKYLINE BACKDROP ==================== -->
  <div id="skyline-stage" aria-hidden="true">
    <div id="skyline-photo-wrap">
      <img
        id="skyline-photo"
