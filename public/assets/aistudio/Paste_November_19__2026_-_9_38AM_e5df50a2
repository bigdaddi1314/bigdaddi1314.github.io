    // Discreet Owner STL Export Tools
    function downloadStlGroup(group, filename) {
      if (!studioReady || typeof THREE.STLExporter === 'undefined') {
        showToast('3D export unavailable in this browser');
        return;
      }
      try {
        const exporter = new THREE.STLExporter();
        const data = exporter.parse(group, { binary: true });
        const blob = new Blob([data], { type: 'application/octet-stream' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = filename;
        link.click();
        showToast(`Downloaded ${filename}`);
      } catch (err) {
        showToast('Could not generate STL export');
      }
    }

