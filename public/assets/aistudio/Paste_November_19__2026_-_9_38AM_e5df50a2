    let studioScene, studioCamera, studioRenderer, studioControls;
    let studioBodyGroup, studioLidPivot, studioBodyMat, studioHardwareMat;
    let studioReady = false;

    function getResolvedStudioConfig() {
      const sz = APP_DATA.sizes.find((s) => s.id === studioState.size) || APP_DATA.sizes[1];
      const tx = APP_DATA.textures.find((t) => t.id === studioState.texture) || APP_DATA.textures[0];
      const col = APP_DATA.colors.find((c) => c.id === studioState.color) || APP_DATA.colors[0];
      const hdl = APP_DATA.handles.find((h) => h.id === studioState.handle) || APP_DATA.handles[0];
      const clp = APP_DATA.clasps.find((c) => c.id === studioState.clasp) || APP_DATA.clasps[0];
      const shp = APP_DATA.silhouettes.find((s) => s.id === studioState.shape) || APP_DATA.silhouettes[0];

      // Boutique Pricing ($68 - $96)
      let price = 76 + sz.priceDelta + hdl.priceDelta + clp.priceDelta;
      if (studioState.badge !== 'none' && studioState.monogram.trim()) price += 4;
      price = Math.max(68, Math.min(96, price));

      return {
        shape: studioState.shape,
        shapeName: shp.name,
        sizeName: sz.name,
        width: sz.width,
        height: sz.height,
        depth: sz.depth,
        lidHeight: sz.lidHeight,
        texture: studioState.texture,
        textureName: tx.name,
        texDepth: tx.depth,
        colorName: col.name,
        colorCss: col.hex,
        threeHex: col.threeHex,
        rough: col.rough,
        metal: col.metal,
        finish: col.finish,
        handle: studioState.handle,
        handleName: hdl.name,
        clasp: studioState.clasp,
        claspName: clp.name,
        badge: studioState.badge,
        monogram: studioState.monogram,
        lidAngle: studioState.lidAngle,
        price
      };
    }

    function initStudio3D() {
      const mount = document.getElementById('studioPurseMount');
      const fallback = document.getElementById('studioWebglFallback');

      try {
        studioScene = new THREE.Scene();
        studioCamera = new THREE.PerspectiveCamera(38, Math.max(1, mount.clientWidth) / Math.max(1, mount.clientHeight), 1, 2500);
        studioCamera.position.set(78, 160, 290);

        studioRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        studioRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        studioRenderer.setSize(mount.clientWidth, mount.clientHeight);
        mount.appendChild(studioRenderer.domElement);

        studioControls = new THREE.OrbitControls(studioCamera, studioRenderer.domElement);
        studioControls.target.set(0, 62, 0);
        studioControls.enableDamping = true;
        studioControls.dampingFactor = 0.06;
        studioControls.minDistance = 150;
        studioControls.maxDistance = 460;
        studioControls.autoRotate = studioState.autoRotate;
        studioControls.autoRotateSpeed = 1.4;

        addBoutiqueLighting(studioScene);

        studioBodyMat = new THREE.MeshStandardMaterial({
          color: 0xE89BB5,
          roughness: 0.30,
          metalness: 0.14,
          side: THREE.DoubleSide
        });
        studioHardwareMat = new THREE.MeshStandardMaterial({
          color: 0xD8B488,
          roughness: 0.24,
          metalness: 0.62,
          side: THREE.DoubleSide
        });

        studioBodyGroup = new THREE.Group();
        studioLidPivot = new THREE.Group();
        studioScene.add(studioBodyGroup, studioLidPivot);
        studioReady = true;

        window.addEventListener('resize', () => {
          if (!mount.clientWidth || !mount.clientHeight) return;
          studioCamera.aspect = mount.clientWidth / mount.clientHeight;
          studioCamera.updateProjectionMatrix();
          studioRenderer.setSize(mount.clientWidth, mount.clientHeight);
        });

        let studioVisible = true;
        if ('IntersectionObserver' in window) {
          new IntersectionObserver((entries) => {
            studioVisible = entries[0].isIntersecting;
          }).observe(mount);
        }

        function animateStudio() {
          requestAnimationFrame(animateStudio);
          if (!studioVisible) return;
          studioControls.update();
          studioRenderer.render(studioScene, studioCamera);
        }
        animateStudio();
      } catch (err) {
        fallback.classList.remove('hidden');
      }
    }

    function rebuildStudioPurse() {
      const cfg = getResolvedStudioConfig();

      // Update UI text readouts
      document.getElementById('studioPriceDisplay').textContent = `$${cfg.price}`;
      document.getElementById('studioStageTitle').textContent = `${cfg.shapeName} · ${cfg.colorName}`;
      document.getElementById('studioStageDot').style.background = cfg.colorCss;
      document.getElementById('selectedShadeName').textContent = `${cfg.colorName} (${cfg.finish})`;
      document.getElementById('ownerDimReadout').textContent = `Dimensions: ${cfg.width} × ${cfg.depth} × ${cfg.height} mm (+${cfg.lidHeight} mm Lid)`;

      const peekLabel = cfg.lidAngle <= 4 ? 'Closed' : cfg.lidAngle < 45 ? 'Slightly Open' : 'Open Wide';
      document.getElementById('peekStatusLabel').textContent = peekLabel;

      if (!studioReady) return;

      studioBodyMat.color.setHex(cfg.threeHex);
      studioBodyMat.roughness = cfg.rough;
      studioBodyMat.metalness = cfg.metal;

      disposeGroup(studioBodyGroup);
      disposeGroup(studioLidPivot);

      const body = createPurseBodyGroup(cfg, studioBodyMat, studioHardwareMat);
      studioBodyGroup.add(body);

      const lid = createPurseLidGroup(cfg, studioBodyMat, studioHardwareMat);
      const backPt = getOffsetPoint(0.75, cfg, 0, 1.0);
      const hingeZ = backPt.z - 4.2;

      studioLidPivot.position.set(0, cfg.height, hingeZ);
      lid.position.set(0, 0, -hingeZ);
      studioLidPivot.rotation.x = -(cfg.lidAngle * Math.PI) / 180;
      studioLidPivot.add(lid);
    }

