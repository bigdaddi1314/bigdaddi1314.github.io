      />
    </div>
    <div id="skyline-wash" class="wash-golden-blush"></div>
    <div id="skyline-veil"></div>
    <canvas id="bokeh-canvas"></canvas>
  </div>

  <!-- ==================== MAIN FOREGROUND APPLICATION ==================== -->
  <div class="relative z-10 flex flex-col min-h-screen">

    <!-- ==================== 1. TOP ANNOUNCEMENT STRIP & FROSTED HEADER ==================== -->
    <div class="bg-[#FFF4F7]/92 backdrop-blur-md border-b border-champagne/30 text-espresso">
