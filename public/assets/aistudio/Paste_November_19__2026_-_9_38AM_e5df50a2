          </a>

          <!-- Desktop Nav Links -->
          <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-mauve">
            <a href="#lookbook" class="hover:text-roseBerry transition-colors">Lookbook</a>
            <a href="#purse-studio" class="hover:text-roseBerry transition-colors inline-flex items-center gap-1.5 text-espresso font-semibold">
              <span>Design Your Purse</span>
