            </a>
            <a href="#bespoke" class="hover:text-roseBerry transition-colors">Bespoke Orders</a>
            <a href="#our-story" class="hover:text-roseBerry transition-colors">Our Story</a>
          </nav>

          <!-- Right Actions: Bag Pill -->
          <div class="flex items-center gap-3">
            <button id="openBagBtn" type="button" class="inline-flex items-center gap-2 px-4 sm:px-5 py-2.5 rounded-full bg-espresso hover:bg-roseBerry text-pearl text-xs sm:text-sm font-semibold transition-all shadow-md">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                <path d="M6 7h12l1 13H5L6 7z" />
                <path d="M9 7V6a3 3 0 0 1 6 0v1" />
