      const wrap = document.getElementById('skyline-photo-wrap');
      const wash = document.getElementById('skyline-wash');
      const canvas = document.getElementById('bokeh-canvas');
      const ctx = canvas.getContext('2d');

      // Graceful onerror fallback chain for photorealistic Charlotte skyline
      let triedFallback = false;
      img.addEventListener('error', () => {
        if (!triedFallback) {
          triedFallback = true;
          img.src = APP_DATA.skylineImages.fallback;
        } else {
          img.style.display = 'none';
        }
      });

      // Skyline Glow Switcher
      document.querySelectorAll('.glow-pill').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.glow-pill').forEach((b) => {
            b.className = 'glow-pill px-2.5 py-0.5 rounded-full text-[11px] font-semibold transition-all text-mauve hover:text-espresso';
          });
          btn.className = 'glow-pill px-2.5 py-0.5 rounded-full text-[11px] font-semibold transition-all bg-roseBerry text-white';
          wash.className = `wash-${btn.dataset.glow}`;
          img.style.filter = btn.dataset.glow === 'clear-skyline'
            ? 'saturate(1.08) brightness(1.08) contrast(1.05)'
            : 'saturate(1.16) brightness(1.06) contrast(1.03)';
        });
      });

      // Golden-champagne & soft rose bokeh motes
      let w = 0, h = 0;
      const motes = [];
      const bokehColors = [
        'rgba(255, 224, 189, 0.42)',
        'rgba(251, 210, 224, 0.38)',
        'rgba(255, 248, 240, 0.36)',
        'rgba(218, 174, 128, 0.32)'
      ];

      function resizeBokeh() {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
      }
      window.addEventListener('resize', resizeBokeh);
      resizeBokeh();

      for (let i = 0; i < 38; i++) {
        motes.push({
          x: Math.random() * w,
          y: Math.random() * h,
          r: Math.random() * 5.5 + 1.8,
          vy: -(Math.random() * 0.22 + 0.06),
          vx: (Math.random() - 0.5) * 0.14,
          color: bokehColors[i % bokehColors.length],
          phase: Math.random() * Math.PI * 2
        });
      }

      let smoothProgress = 0;
      function animateBackdrop(ts) {
        requestAnimationFrame(animateBackdrop);

        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const targetProgress = Math.min(1, Math.max(0, window.scrollY / maxScroll));
        smoothProgress += (targetProgress - smoothProgress) * 0.06;

        // Smooth panoramic parallax: gentle vertical glide + horizontal pan + subtle slow Ken Burns zoom
        const kenBurns = 1.03 + 0.03 * Math.sin(ts * 0.00018) + smoothProgress * 0.05;
        const panX = -smoothProgress * 3.4 + Math.sin(ts * 0.00014) * 0.6;
        const glideY = -smoothProgress * 3.2;
        wrap.style.transform = `translate3d(${panX.toFixed(3)}%, ${glideY.toFixed(3)}%, 0) scale(${kenBurns.toFixed(4)})`;

        // Soft drifting bokeh light motes
        ctx.clearRect(0, 0, w, h);
        for (let i = 0; i < motes.length; i++) {
          const m = motes[i];
          m.y += m.vy;
          m.x += m.vx + Math.sin(ts * 0.0007 + m.phase) * 0.08;
          if (m.y < -15) { m.y = h + 15; m.x = Math.random() * w; }
          if (m.x < -15) m.x = w + 15;
          if (m.x > w + 15) m.x = -15;

          const pulse = 0.55 + 0.45 * Math.sin(ts * 0.0014 + m.phase);
          ctx.beginPath();
          ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
          ctx.fillStyle = m.color;
          ctx.globalAlpha = pulse;
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      }
      requestAnimationFrame(animateBackdrop);
    })();

    // =========================================================================
    // 4. SHARED PROCEDURAL 3D PURSE GEOMETRY ENGINE (Three.js r128)
    // =========================================================================
    function regularPolyR(theta, sides, roundness = 0.14) {
      const slice = (Math.PI * 2) / sides;
      const a = ((theta % slice) + slice) % slice - slice * 0.5;
      const polyR = Math.cos(slice * 0.5) / Math.cos(a);
      return (1 - roundness) * polyR + roundness;
    }

    function getSilhouettePoint(u, shape, width, depth) {
      const theta = u * Math.PI * 2;
      const hw = width * 0.5;
      const hd = depth * 0.5;
      let x = 0, z = 0;

      switch (shape) {
        case 'heart': {
          const hx = Math.pow(Math.sin(theta), 3);
          const hz = (13 * Math.cos(theta) - 5 * Math.cos(2 * theta) - 2 * Math.cos(3 * theta) - Math.cos(4 * theta)) / 16;
          x = hw * hx;
          z = -hd * (hz - 0.14);
          break;
        }
        case 'star5': {
          const sf = 0.70 + 0.30 * Math.cos(theta * 5 - Math.PI / 2);
          x = hw * Math.cos(theta) * sf;
          z = hd * Math.sin(theta) * sf;
          break;
        }
        case 'tote': {
          const n = 3.6;
          const cosT = Math.cos(theta), sinT = Math.sin(theta);
          x = hw * Math.sign(cosT) * Math.pow(Math.abs(cosT), 2 / n);
          z = hd * Math.sign(sinT) * Math.pow(Math.abs(sinT), 2 / n);
          break;
        }
        case 'octagon': {
          const r = regularPolyR(theta + Math.PI / 8, 8, 0.13);
          x = hw * Math.cos(theta) * r;
          z = hd * Math.sin(theta) * r;
          break;
        }
        case 'crescent': {
          // Graceful half-moon curve in XZ with rounded pouch gusset
          const cosT = Math.cos(theta);
          const sinT = Math.sin(theta);
          const arch = 0.32 * Math.cos(cosT * Math.PI * 0.5);
          x = hw * cosT;
          z = hd * (sinT * 0.76 - arch + 0.16);
          break;
        }
        case 'diamond': {
          const denom = Math.pow(Math.abs(Math.cos(theta)), 1.25) + Math.pow(Math.abs(Math.sin(theta)), 1.25);
          x = (hw / denom) * Math.cos(theta);
          z = (hd / denom) * Math.sin(theta);
          break;
        }
        case 'scallop': {
          const wave = 0.87 + 0.13 * Math.abs(Math.cos(theta * 4));
          x = hw * Math.cos(theta) * wave;
          z = hd * Math.sin(theta) * wave;
          break;
        }
        default: { // drum
          x = hw * Math.cos(theta);
          z = hd * Math.sin(theta);
        }
      }
      return { x, z };
    }

    function getSurfaceTextureOffset(u, v, textureId, depthMm) {
      if (textureId === 'smooth' || depthMm <= 0) return 0;
      const freqU = 16, freqV = 8;
      const fade = Math.sin(Math.min(1, v * 6) * Math.PI * 0.5) * Math.sin(Math.min(1, (1 - v) * 6) * Math.PI * 0.5);
      let val = 0;

      if (textureId === 'quilt') {
        const d1 = Math.abs(Math.sin((u * freqU + v * freqV) * Math.PI));
        const d2 = Math.abs(Math.sin((u * freqU - v * freqV) * Math.PI));
        val = Math.pow(d1 * d2, 0.45) * depthMm;
      } else if (textureId === 'chevron') {
        const vWave = Math.abs(((u * 2) % 1) - 0.5) * 2;
        val = (Math.sin((v * freqV * 1.4 + vWave * 2.4) * Math.PI * 2) * 0.5 + 0.5) * depthMm;
      } else if (textureId === 'woven') {
        const wu = Math.sin(u * freqU * Math.PI * 2);
        const wv = Math.sin(v * freqV * Math.PI * 2);
        const checker = Math.sign(Math.sin(u * freqU * Math.PI) * Math.sin(v * freqV * Math.PI));
        val = ((checker > 0 ? Math.abs(wu) : Math.abs(wv)) * 0.85) * depthMm;
      } else if (textureId === 'pleats') {
        val = Math.abs(Math.sin(u * freqU * 1.5 * Math.PI)) * depthMm;
      }
      return val * fade;
    }

    function getOffsetPoint(u, cfg, radialOffset = 0, scaleFactor = 1.0) {
      const base = getSilhouettePoint(u, cfg.shape, cfg.width, cfg.depth);
      let x = base.x * scaleFactor;
      let z = base.z * scaleFactor;
      const len = Math.sqrt(x * x + z * z) || 1;
      x += (x / len) * radialOffset;
      z += (z / len) * radialOffset;
      return { x, z };
    }

    // Crisp Gold/Pearl Boutique Monogram Canvas Texture for Front Emblem
    function makeBoutiqueMonogramTexture(text, baseHex) {
      const c = document.createElement('canvas');
      c.width = 512;
      c.height = 320;
      const g = c.getContext('2d');

      // Soft satin metallic plaque backdrop
      const grad = g.createLinearGradient(0, 0, c.width, c.height);
      const isDark = baseHex.toLowerCase() === '#342429' || baseHex.toLowerCase() === '#a92246';
      if (isDark) {
        grad.addColorStop(0, '#E8CCA5');
        grad.addColorStop(1, '#C6986C');
      } else {
        grad.addColorStop(0, '#FFF8F2');
        grad.addColorStop(1, '#F3DFCE');
      }
      g.fillStyle = grad;
      g.fillRect(0, 0, c.width, c.height);

      // Delicate inner border
      g.strokeStyle = isDark ? 'rgba(255,251,248,0.65)' : 'rgba(198,152,108,0.8)';
      g.lineWidth = 10;
      g.strokeRect(18, 18, c.width - 36, c.height - 36);

      const letters = (text || '').trim().toUpperCase().slice(0, 4);
      if (letters) {
        g.font = '700 132px "Cormorant Garamond", Georgia, serif';
        g.textAlign = 'center';
        g.textBaseline = 'middle';
        g.fillStyle = isDark ? '#24191D' : '#8A5A3C';
        g.fillText(letters, c.width / 2, c.height / 2 + 8);
      }

      const tex = new THREE.CanvasTexture(c);
      tex.needsUpdate = true;
      return tex;
    }

    // Build Lower Purse Body (Smooth Manifold Geometry)
    function createPurseBodyGroup(cfg, bodyMat, hardwareMat) {
      const group = new THREE.Group();
      const segU = 136, segV = 48;
      const positions = [], indices = [];
      const addV = (x, y, z) => { positions.push(x, y, z); return (positions.length / 3) - 1; };

      const wall = 3.2;
      const floorT = 3.8;
      const outerGrid = [], innerGrid = [];

      for (let iv = 0; iv <= segV; iv++) {
        const v = iv / segV;
        const yOut = v * cfg.height;
        const yIn = floorT + v * (cfg.height - floorT);
        // Subtle organic boutique soften near bottom base
        const baseRound = 1.0 - 0.04 * Math.pow(1 - v, 3);
        const rOut = [], rIn = [];

        for (let iu = 0; iu < segU; iu++) {
          const u = iu / segU;
          const tex = getSurfaceTextureOffset(u, v, cfg.texture, cfg.texDepth);
          const pOut = getOffsetPoint(u, cfg, tex, baseRound);
          const pIn = getOffsetPoint(u, cfg, -wall, baseRound);
          rOut.push(addV(pOut.x, yOut, pOut.z));
          rIn.push(addV(pIn.x, yIn, pIn.z));
        }
        outerGrid.push(rOut);
        innerGrid.push(rIn);
      }

      for (let iv = 0; iv < segV; iv++) {
        for (let iu = 0; iu < segU; iu++) {
          const nU = (iu + 1) % segU;
          indices.push(outerGrid[iv][iu], outerGrid[iv + 1][nU], outerGrid[iv][nU]);
          indices.push(outerGrid[iv][iu], outerGrid[iv + 1][iu], outerGrid[iv + 1][nU]);

          indices.push(innerGrid[iv][iu], innerGrid[iv][nU], innerGrid[iv + 1][nU]);
          indices.push(innerGrid[iv][iu], innerGrid[iv + 1][nU], innerGrid[iv + 1][iu]);
        }
      }

      for (let iu = 0; iu < segU; iu++) {
        const nU = (iu + 1) % segU;
        indices.push(outerGrid[segV][iu], outerGrid[segV][nU], innerGrid[segV][nU]);
        indices.push(outerGrid[segV][iu], innerGrid[segV][nU], innerGrid[segV][iu]);
      }

      const outC = addV(0, 0, 0), inC = addV(0, floorT, 0);
      for (let iu = 0; iu < segU; iu++) {
        const nU = (iu + 1) % segU;
        indices.push(outC, outerGrid[0][nU], outerGrid[0][iu]);
        indices.push(inC, innerGrid[0][iu], innerGrid[0][nU]);
      }

      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geo.setIndex(indices);
      geo.computeVertexNormals();
      group.add(new THREE.Mesh(geo, bodyMat));

      const backPt = getOffsetPoint(0.75, cfg, 0, 1.0);
      const frontPt = getOffsetPoint(0.25, cfg, 0, 1.0);

      // Rear Hinged Knuckles
      const hZ = backPt.z - 4.2;
      const span = Math.min(34, cfg.width * 0.24);
      [-span * 0.65, span * 0.65].forEach((xPos) => {
        const knuck = new THREE.CylinderGeometry(4.6, 4.6, span * 0.44, 24);
        knuck.rotateZ(Math.PI / 2);
        knuck.translate(xPos, cfg.height, hZ);
        group.add(new THREE.Mesh(knuck, bodyMat));
      });
      const pin = new THREE.CylinderGeometry(2.1, 2.1, span * 1.65, 20);
      pin.rotateZ(Math.PI / 2);
      pin.translate(0, cfg.height, hZ);
      group.add(new THREE.Mesh(pin, hardwareMat));

      // Front Closure Hardware
      if (cfg.clasp === 'snap') {
        const stud = new THREE.BoxGeometry(18, 6, 4.2);
        stud.translate(0, cfg.height - 5, frontPt.z + 2.0);
        group.add(new THREE.Mesh(stud, hardwareMat));
      } else {
        // Subtle recessed magnetic pads inside top front rim
        [-18, 18].forEach((mx) => {
          const pad = new THREE.CylinderGeometry(4, 4, 2.2, 18);
          pad.translate(mx, cfg.height - 1.2, frontPt.z - 4.5);
          group.add(new THREE.Mesh(pad, hardwareMat));
        });
      }

      // Crossbody Side D-Ring Loops
      if (cfg.handle === 'side_loops' || cfg.handle === 'both') {
        const rightPt = getOffsetPoint(0.0, cfg, 0, 1.0);
        const leftPt = getOffsetPoint(0.5, cfg, 0, 1.0);
        [rightPt.x + 2, leftPt.x - 2].forEach((xPos) => {
          const loop = new THREE.TorusGeometry(8.5, 2.8, 14, 28);
          loop.rotateY(Math.PI / 2);
          loop.translate(xPos, cfg.height * 0.84, 0);
          group.add(new THREE.Mesh(loop, hardwareMat));
        });
      }

      // Front Center Medallion Plaque + Live 3D Monogram
      if (cfg.badge !== 'none') {
        const fMid = getOffsetPoint(0.25, cfg, cfg.texDepth, 1.0);
        const bDepth = 4.6;
        let bGeo = null;

        if (cfg.badge === 'circle') {
          bGeo = new THREE.CylinderGeometry(18, 19.2, bDepth, 40);
          bGeo.rotateX(Math.PI / 2);
        } else if (cfg.badge === 'plaque') {
          bGeo = new THREE.BoxGeometry(44, 24, bDepth);
        } else if (cfg.badge === 'diamond') {
          bGeo = new THREE.BoxGeometry(26, 26, bDepth);
          bGeo.rotateZ(Math.PI / 4);
        } else if (cfg.badge === 'shield') {
          const s = new THREE.Shape();
          s.moveTo(0, 20);
          s.lineTo(17, 14);
          s.quadraticCurveTo(17, -8, 0, -21);
          s.quadraticCurveTo(-17, -8, -17, 14);
          s.closePath();
          bGeo = new THREE.ExtrudeGeometry(s, { depth: bDepth, bevelEnabled: true, bevelThickness: 1.1, bevelSize: 0.9, bevelSegments: 2 });
          bGeo.translate(0, 0, -bDepth * 0.5);
        }

        if (bGeo) {
          bGeo.translate(0, cfg.height * 0.52, fMid.z + 1.8);
          group.add(new THREE.Mesh(bGeo, hardwareMat));

          if (cfg.monogram && cfg.monogram.trim().length > 0) {
            const monoTex = makeBoutiqueMonogramTexture(cfg.monogram, cfg.colorCss);
            const monoMat = new THREE.MeshStandardMaterial({ map: monoTex, roughness: 0.28, metalness: 0.22 });
            const wPlaque = cfg.badge === 'plaque' ? 36 : 26;
            const hPlaque = cfg.badge === 'plaque' ? 18 : 16;
            const monoPlate = new THREE.BoxGeometry(wPlaque, hPlaque, 1.2);
            monoPlate.translate(0, cfg.height * 0.52, fMid.z + 1.8 + bDepth * 0.5 + 0.65);
            group.add(new THREE.Mesh(monoPlate, monoMat));
          }
        }
      }

      return group;
    }

    // Build Hinged Domed Lid + Top Arch Handle
    function createPurseLidGroup(cfg, bodyMat, hardwareMat) {
      const lidGroup = new THREE.Group();
      const segU = 136, segV = 22;
      const positions = [], indices = [];
      const addV = (x, y, z) => { positions.push(x, y, z); return (positions.length / 3) - 1; };

      const wall = 3.2;
      const roofT = 3.2;
      const outerGrid = [], innerGrid = [];

      for (let iv = 0; iv <= segV; iv++) {
        const v = iv / segV;
        const yOut = v * cfg.lidHeight;
        const yIn = v * (cfg.lidHeight - roofT);
        const crownScale = 1.0 - 0.08 * Math.pow(v, 2);
        const rOut = [], rIn = [];

        for (let iu = 0; iu < segU; iu++) {
          const u = iu / segU;
          const tex = getSurfaceTextureOffset(u, v, cfg.texture, cfg.texDepth) * (1 - v * 0.72);
          const pOut = getOffsetPoint(u, cfg, tex, crownScale);
          const pIn = getOffsetPoint(u, cfg, -wall, crownScale);
          rOut.push(addV(pOut.x, yOut, pOut.z));
          rIn.push(addV(pIn.x, yIn, pIn.z));
        }
        outerGrid.push(rOut);
        innerGrid.push(rIn);
      }

      for (let iv = 0; iv < segV; iv++) {
        for (let iu = 0; iu < segU; iu++) {
          const nU = (iu + 1) % segU;
          indices.push(outerGrid[iv][iu], outerGrid[iv + 1][nU], outerGrid[iv][nU]);
          indices.push(outerGrid[iv][iu], outerGrid[iv + 1][iu], outerGrid[iv + 1][nU]);

          indices.push(innerGrid[iv][iu], innerGrid[iv][nU], innerGrid[iv + 1][nU]);
          indices.push(innerGrid[iv][iu], innerGrid[iv + 1][nU], innerGrid[iv + 1][iu]);
        }
      }

      const outRoof = addV(0, cfg.lidHeight, 0);
      const inRoof = addV(0, cfg.lidHeight - roofT, 0);
      for (let iu = 0; iu < segU; iu++) {
        const nU = (iu + 1) % segU;
        indices.push(outRoof, outerGrid[segV][iu], outerGrid[segV][nU]);
        indices.push(inRoof, innerGrid[segV][nU], innerGrid[segV][iu]);
        indices.push(outerGrid[0][iu], innerGrid[0][nU], outerGrid[0][nU]);
        indices.push(outerGrid[0][iu], innerGrid[0][iu], innerGrid[0][nU]);
      }

      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geo.setIndex(indices);
      geo.computeVertexNormals();
      lidGroup.add(new THREE.Mesh(geo, bodyMat));

      const backPt = getOffsetPoint(0.75, cfg, 0, 1.0);
      const frontPt = getOffsetPoint(0.25, cfg, 0, 1.0);

      // Center Rear Hinge Knuckle
      const hZ = backPt.z - 4.2;
      const span = Math.min(34, cfg.width * 0.24);
      const midKnuck = new THREE.CylinderGeometry(4.3, 4.3, span * 0.70, 24);
      midKnuck.rotateZ(Math.PI / 2);
      midKnuck.translate(0, 0, hZ);
      lidGroup.add(new THREE.Mesh(midKnuck, bodyMat));

      // Front Clasp Tab
      if (cfg.clasp === 'snap') {
        const claspArm = new THREE.BoxGeometry(20, 13, 3.6);
        claspArm.translate(0, -3.5, frontPt.z + 3.2);
        lidGroup.add(new THREE.Mesh(claspArm, hardwareMat));
      }

      // Sculpted Top Arch Handle on Lid
      if (cfg.handle === 'lid_arch' || cfg.handle === 'both') {
        const archR = Math.min(36, cfg.width * 0.23);
        const handleGeo = new THREE.TorusGeometry(archR, 4.2, 16, 40, Math.PI);
        handleGeo.translate(0, cfg.lidHeight - 1, 0);
        lidGroup.add(new THREE.Mesh(handleGeo, bodyMat));
      }

      return lidGroup;
    }

    function disposeGroup(g) {
      while (g.children.length > 0) {
        const c = g.children[0];
        if (c.geometry) c.geometry.dispose();
        g.remove(c);
      }
    }

    // Soft bright boutique lighting helper (keeps pastel/pearl/gold luminous & crisp)
    function addBoutiqueLighting(scene) {
