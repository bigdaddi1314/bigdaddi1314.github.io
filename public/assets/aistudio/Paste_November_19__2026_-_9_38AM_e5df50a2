    // =========================================================================
    const bespokeFileInput = document.getElementById('bespokeFileInput');
    const bespokeDropZone = document.getElementById('bespokeDropZone');

    function handleBespokeFile(file) {
      if (!file) return;
      document.getElementById('bespokeFileLabel').textContent = `Attached: ${file.name}`;
      if (file.type && file.type.startsWith('image/')) {
        const url = URL.createObjectURL(file);
        document.getElementById('bespokeThumbImg').src = url;
        document.getElementById('bespokeThumbWrap').classList.remove('hidden');
        document.getElementById('bespokeUploadIcon').classList.add('hidden');
      } else {
        document.getElementById('bespokeThumbWrap').classList.add('hidden');
        document.getElementById('bespokeUploadIcon').classList.remove('hidden');
      }
      showToast(`Attached ${file.name}`);
    }

    bespokeFileInput.addEventListener('change', (e) => handleBespokeFile(e.target.files[0]));
    bespokeDropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      bespokeDropZone.classList.add('border-roseBerry', 'bg-blush/65');
    });
    bespokeDropZone.addEventListener('dragleave', () => {
      bespokeDropZone.classList.remove('border-roseBerry', 'bg-blush/65');
    });
    bespokeDropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      bespokeDropZone.classList.remove('border-roseBerry', 'bg-blush/65');
      handleBespokeFile(e.dataTransfer.files[0]);
    });

    const bespokeModal = document.getElementById('bespokeModal');
    document.getElementById('bespokeForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('bespokeName').value.trim() || 'lovely';
      const type = document.getElementById('bespokeType').value;
      document.getElementById('bespokeConfirmCopy').textContent =
        `Thank you, ${name}! Our Charlotte atelier received your ${type} request and will reply within 24 hours with color match options and a personal quote.`;
      bespokeModal.classList.remove('hidden');
      bespokeModal.classList.add('flex');
      e.target.reset();
      document.getElementById('bespokeFileLabel').textContent = 'Upload an outfit photo, color swatch, or sketch';
      document.getElementById('bespokeThumbWrap').classList.add('hidden');
      document.getElementById('bespokeUploadIcon').classList.remove('hidden');
    });
    document.getElementById('closeBespokeModalBtn').addEventListener('click', () => {
      bespokeModal.classList.add('hidden');
      bespokeModal.classList.remove('flex');
    });

    // =========================================================================
    // 9. SLIDE-OVER SHOPPING BAG & BOUTIQUE CHECKOUT
    // =========================================================================
    let bagItems = [];
    let fulfillmentMode = 'pickup'; // 'pickup' | 'shipping'

    function openBag() {
      const overlay = document.getElementById('bagOverlay');
      const drawer = document.getElementById('bagDrawer');
      overlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        overlay.classList.remove('opacity-0');
        drawer.classList.remove('translate-x-full');
      });
    }

    function closeBag() {
      const overlay = document.getElementById('bagOverlay');
      const drawer = document.getElementById('bagDrawer');
      overlay.classList.add('opacity-0');
      drawer.classList.add('translate-x-full');
      setTimeout(() => overlay.classList.add('hidden'), 300);
    }

    document.getElementById('openBagBtn').addEventListener('click', openBag);
    document.getElementById('mobileBagBtn').addEventListener('click', openBag);
    document.getElementById('closeBagBtn').addEventListener('click', closeBag);
    document.getElementById('bagOverlay').addEventListener('click', closeBag);

    window.addCatalogItemToBag = function(id) {
      const item = APP_DATA.catalog.find((i) => i.id === id);
      if (!item) return;
      const existing = bagItems.find((b) => b.key === item.id);
      if (existing) existing.qty += 1;
      else {
        bagItems.push({
          key: item.id,
          name: item.name,
          price: item.price,
          qty: 1,
          swatchHex: item.preset ? (APP_DATA.colors.find((c) => c.id === item.preset.color)?.hex || '#E89BB5') : '#D6B082',
          details: item.finishTag
        });
      }
      renderBag();
      showToast(`Added "${item.name}" to your bag`);
    };

    document.getElementById('addCustomPurseBtn').addEventListener('click', () => {
      const cfg = getResolvedStudioConfig();
      const detailParts = [
        `${cfg.sizeName} Size`,
        cfg.textureName,
        `${cfg.colorName} (${cfg.finish})`,
        cfg.handleName,
        cfg.claspName
      ];
      if (cfg.badge !== 'none') {
        detailParts.push(cfg.monogram.trim() ? `Monogram "${cfg.monogram.trim().toUpperCase()}"` : 'Blank Medallion');
      }
      if (studioState.giftNote.trim()) {
        detailParts.push(`Note: ${studioState.giftNote.trim()}`);
      }

      bagItems.push({
        key: 'custom-' + Date.now(),
        name: `Custom ${cfg.shapeName}`,
        price: cfg.price,
        qty: 1,
        swatchHex: cfg.colorCss,
        details: detailParts.join(' · ')
      });
      renderBag();
      openBag();
      showToast(`Added Custom ${cfg.shapeName} to your bag`);
    });

    window.changeBagQty = function(key, delta) {
      const idx = bagItems.findIndex((b) => b.key === key);
      if (idx === -1) return;
      bagItems[idx].qty += delta;
      if (bagItems[idx].qty <= 0) bagItems.splice(idx, 1);
      renderBag();
    };

    function renderBag() {
      const totalCount = bagItems.reduce((acc, i) => acc + i.qty, 0);
      document.getElementById('headerBagCount').textContent = totalCount;

      const mobileBadge = document.getElementById('mobileBagBadge');
      mobileBadge.textContent = totalCount;
      mobileBadge.classList.toggle('hidden', totalCount === 0);

      const listEl = document.getElementById('bagItemsList');
      if (bagItems.length === 0) {
        listEl.innerHTML = `
          <div class="text-center py-14 space-y-3">
            <div class="w-14 h-14 mx-auto rounded-full bg-blush/70 border border-champagne/40 flex items-center justify-center text-roseBerry">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M6 7h12l1 13H5L6 7z" /><path d="M9 7V6a3 3 0 0 1 6 0v1" />
              </svg>
            </div>
            <div class="font-serif font-bold text-2xl text-espresso">Your Boutique Bag is Empty</div>
            <p class="text-xs text-mauve max-w-[230px] mx-auto">Explore our Charlotte lookbook or design your custom handbag in the 3D Atelier.</p>
          </div>
        `;
      } else {
        listEl.innerHTML = bagItems.map((item) => `
          <div class="p-4 rounded-2xl bg-white border border-champagne/35 shadow-sm space-y-2.5">
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full border border-black/10 shrink-0" style="background:${item.swatchHex}"></span>
                <h4 class="font-serif font-bold text-lg text-espresso leading-tight">${item.name}</h4>
              </div>
              <span class="font-semibold text-sm text-roseBerry">$${item.price * item.qty}</span>
            </div>
            <p class="text-xs text-mauve leading-relaxed">${item.details}</p>
            <div class="flex items-center justify-between pt-1">
              <div class="inline-flex items-center gap-2 bg-blush/50 rounded-full border border-champagne/35 px-1.5 py-0.5">
                <button type="button" onclick="changeBagQty('${item.key}', -1)" class="w-6 h-6 rounded-full bg-white text-espresso hover:text-roseBerry font-bold text-xs">&minus;</button>
                <span class="text-xs font-semibold text-espresso px-1">${item.qty}</span>
                <button type="button" onclick="changeBagQty('${item.key}', 1)" class="w-6 h-6 rounded-full bg-white text-espresso hover:text-roseBerry font-bold text-xs">+</button>
              </div>
              <button type="button" onclick="changeBagQty('${item.key}', -999)" class="text-xs text-mauve hover:text-roseBerry underline underline-offset-2">Remove</button>
            </div>
          </div>
        `).join('');
      }

      const subtotal = bagItems.reduce((acc, i) => acc + i.price * i.qty, 0);
      const qualifiesFreeShip = subtotal >= APP_DATA.brand.freeShippingThreshold;
      const shippingCost = (subtotal === 0 || fulfillmentMode === 'pickup' || qualifiesFreeShip)
        ? 0
        : APP_DATA.brand.flatShippingRate;
      const total = subtotal + shippingCost;

      document.getElementById('bagSubtotal').textContent = `$${subtotal}`;
      document.getElementById('bagShipping').textContent = shippingCost === 0 ? 'Free' : `$${shippingCost}`;
      document.getElementById('bagTotal').textContent = `$${total}`;
      document.getElementById('openCheckoutBtn').disabled = bagItems.length === 0;

      const hintBar = document.getElementById('shippingHintBar');
      if (fulfillmentMode === 'shipping' && subtotal > 0 && !qualifiesFreeShip) {
        hintBar.textContent = `Add $${APP_DATA.brand.freeShippingThreshold - subtotal} more to unlock complimentary insured shipping!`;
      } else if (fulfillmentMode === 'shipping' && qualifiesFreeShip) {
        hintBar.textContent = 'Complimentary insured shipping unlocked on your order!';
      } else {
        hintBar.textContent = 'Complimentary Boutique Pickup in Charlotte · Free shipping over $120';
      }
    }

    document.getElementById('optPickupBtn').addEventListener('click', () => {
      fulfillmentMode = 'pickup';
      document.getElementById('optPickupBtn').className = 'p-3 rounded-2xl border text-left transition-all bg-white border-roseBerry shadow-sm';
      document.getElementById('optShipBtn').className = 'p-3 rounded-2xl border text-left transition-all bg-white/60 border-champagne/40 text-mauve hover:bg-white';
      renderBag();
    });
    document.getElementById('optShipBtn').addEventListener('click', () => {
      fulfillmentMode = 'shipping';
      document.getElementById('optShipBtn').className = 'p-3 rounded-2xl border text-left transition-all bg-white border-roseBerry shadow-sm';
      document.getElementById('optPickupBtn').className = 'p-3 rounded-2xl border text-left transition-all bg-white/60 border-champagne/40 text-mauve hover:bg-white';
      renderBag();
    });

    // Checkout Modal Flow
    const checkoutModal = document.getElementById('checkoutModal');
    document.getElementById('openCheckoutBtn').addEventListener('click', () => {
      document.getElementById('checkoutModalTotal').textContent = document.getElementById('bagTotal').textContent;
      document.getElementById('checkoutFormState').classList.remove('hidden');
      document.getElementById('checkoutConfirmState').classList.add('hidden');
      checkoutModal.classList.remove('hidden');
      checkoutModal.classList.add('flex');
    });

    function closeCheckoutModal() {
      checkoutModal.classList.add('hidden');
      checkoutModal.classList.remove('flex');
    }
    document.getElementById('closeCheckoutBtn').addEventListener('click', closeCheckoutModal);
    document.getElementById('finishCheckoutBtn').addEventListener('click', () => {
      closeCheckoutModal();
      closeBag();
    });

    document.getElementById('checkoutForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const orderNum = `#M704-${Math.floor(1000 + Math.random() * 9000)}`;
      document.getElementById('confirmOrderNum').textContent = orderNum;
      document.getElementById('checkoutFormState').classList.add('hidden');
      document.getElementById('checkoutConfirmState').classList.remove('hidden');
      bagItems = [];
      renderBag();
      showToast(`Order ${orderNum} confirmed!`);
    });

    // =========================================================================
    // 10. INITIALIZE APPLICATION ON LOAD
    // =========================================================================
    window.addEventListener('load', () => {
      renderLookbookFilters();
      renderLookbookGrid();
      renderStudioControls();
      initStudio3D();
      rebuildStudioPurse();
      renderBag();
    });
  </script>
</body>
</html>