    // =========================================================================
    // 6. GUIDED BOUTIQUE PURSE CUSTOMIZER (4-STEP ATELIER + THREE.JS + STL)
    // =========================================================================
    const studioState = {
      step: 1,
      shape: 'heart',
      size: 'everyday',
      texture: 'quilt',
      color: 'rose-quartz',
      handle: 'lid_arch',
      clasp: 'snap',
      badge: 'shield',
      monogram: 'CLT',
      lidAngle: 22,
      giftNote: '',
      autoRotate: true
